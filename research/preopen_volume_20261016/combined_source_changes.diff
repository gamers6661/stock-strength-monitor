+        at=intraday.parse_quote_timestamp(q.get('quote_at') or q.get('ts'))
+        if not O.quote_traded(q,day) or not at:return False
+        age=(now-at).total_seconds()
+        if age < -config.INTRADAY['max_quote_future_seconds']:return False
+        if now.hour*60+now.minute>=905:return at.hour>=15
+        return at.hour*60+at.minute>=570 and age<=config.INTRADAY['max_quote_age_seconds']
