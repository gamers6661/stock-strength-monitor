    "count": 0,
    "cooldown": 60,
}

# init_worker 与 refresh_loop 可能同时触发全量扫描，用锁串行化
_SCAN_LOCK = threading.Lock()


def publish_outputs():
    """后台每次完成扫描后同步发布看板和文字日报。"""
    try:
        page = make_dashboard.build()
        if page is None or not page.exists():
            raise RuntimeError("看板页面未生成")
        config.atomic_write_text(config.ROOT / "snapshot_report.md", report.build())
        try:
            snapshot = json.loads(config.SNAPSHOT_JSON.read_text(encoding="utf-8"))
            SNAPSHOT_META.update({
                "snapshot_generated_at": snapshot.get("generated_at"),
                "snapshot_scan_completed_at": snapshot.get("scan_completed_at"),
                "snapshot_quote_capture_at": snapshot.get("quote_capture_at"),
                "snapshot_daily_asof": (snapshot.get("strength_model") or {}).get("asof"),
                "snapshot_consolidation_version": (snapshot.get('trend_consolidation') or {}).get('version'),
                "snapshot_consolidation_count": (snapshot.get('trend_consolidation') or {}).get('count'),
                "snapshot_structure_version": (snapshot.get('wyckoff_structure') or {}).get('version'),
                "snapshot_structure_count": (snapshot.get('wyckoff_structure') or {}).get('count'),
                "snapshot_session_context_version": (snapshot.get('session_context') or {}).get('version'),
                "snapshot_context_price_count": (snapshot.get('session_context') or {}).get('price_judged_count'),
                "snapshot_context_structure_count": (snapshot.get('session_context') or {}).get('structure_judged_count'),
                "snapshot_latest_valid_quote_at": (snapshot.get("intraday_model") or {}).get("latest_valid_quote_at"),
                "snapshot_intraday_valid_quotes": (snapshot.get("intraday_model") or {}).get("valid_quote_count"),
                "snapshot_latest_intraday_judgment_at": (snapshot.get("intraday_model") or {}).get("latest_judgment_at"),
                "snapshot_intraday_observation_quotes": (snapshot.get("intraday_model") or {}).get("observation_valid_count"),
                "snapshot_auction_quote_count": (snapshot.get("intraday_model") or {}).get("auction_quote_count"),
                "snapshot_auction_latest_quote_at": (snapshot.get("intraday_model") or {}).get("auction_latest_quote_at"),
                "snapshot_auction_final_count": ((snapshot.get("boundary_prices") or {}).get("auction_final") or {}).get("count"),
                "snapshot_auction_final_captured_at": ((snapshot.get("boundary_prices") or {}).get("auction_final") or {}).get("captured_at"),
                "snapshot_trend_ma5_count": len((snapshot.get("trend_ma5_observation") or {}).get("main_rows") or []),
                "snapshot_trend_ma5_reclaim_count": len((snapshot.get("trend_ma5_observation") or {}).get("reclaim_rows") or []),
                "snapshot_trend_ma10_count": len((snapshot.get("trend_ma10_observation") or {}).get("main_rows") or []),
                "snapshot_trend_ma10_reclaim_count": len((snapshot.get("trend_ma10_observation") or {}).get("reclaim_rows") or []),
                "snapshot_trend_ma20_count": len((snapshot.get("trend_ma20_observation") or {}).get("main_rows") or []),
                "snapshot_trend_ma20_reclaim_count": len((snapshot.get("trend_ma20_observation") or {}).get("reclaim_rows") or []),
                "snapshot_midday_price_count": ((snapshot.get("boundary_prices") or {}).get("midday") or {}).get("count"),
                "snapshot_midday_captured_at": ((snapshot.get("boundary_prices") or {}).get("midday") or {}).get("captured_at"),
                "snapshot_close_price_count": ((snapshot.get("boundary_prices") or {}).get("close") or {}).get("count"),
                "snapshot_close_captured_at": ((snapshot.get("boundary_prices") or {}).get("close") or {}).get("captured_at"),
                "snapshot_intraday_model_version": (snapshot.get("intraday_model") or {}).get("version"),
