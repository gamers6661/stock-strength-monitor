+        rows[c]['market_strength'] = m
+    for b in boards:
+        m = board_current[b['id']]
+        m['history_trend'] = [{'date':d,'score':board_history[d][b['id']]['trend_score']} for d in days]
+        m['history_basis'] = '当前确认成员的历史背景，不是当时成分回测'
