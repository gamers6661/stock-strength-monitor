 def number(value):
     return isinstance(value,(int,float)) and not isinstance(value,bool) and math.isfinite(value)
+
+def cached_status(codes, calendar):
+    """盘后先读已有缓存；缺失目标日不计入完整覆盖，也不发网络请求。"""
+    cache = load(); dates = calendar[-20:]
+    complete = sum(len(dates) == 20 and all(d in {
+        r['date'] for r in (cache.get(c) or {}).get('rows', [])
+        if number(r.get('main_net'))} for d in dates) for c in codes)
+    return dict(requested=0, updated=0, failed=0, complete20=complete,
+                total=len(codes), asof=calendar[-1] if calendar else None,
+                deferred=True, seconds=0)
 
