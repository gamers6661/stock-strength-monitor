+def fetch_reference(codes,begin,asof):
+    url='https://q.stock.sohu.com/hisHq?'+urllib.parse.urlencode(dict(code=','.join('cn_'+c for c in codes),start=begin.replace('-',''),end=asof.replace('-',''),stat=1,order='A',period='d'))
