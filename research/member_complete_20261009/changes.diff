+            raise RuntimeError('成员声明总数无效或超过读取范围')
+        if previous_total is not None and previous_total != total:
+            raise RuntimeError('两次成员请求总数变化，完整性需重核')
+        codes = [str(row.get('5') or '') for row in items]
+        if any(not re.fullmatch(r'\d{6}', c) for c in codes) or len(set(codes)) != len(codes):
+            raise RuntimeError('成员代码无效或重复，不能标记完整')
+        if len(codes) == total:
+            return sorted(codes)
+        if total > limit and len(codes) == limit:
+            previous_total, limit = total, total
+            continue
+        raise RuntimeError(f'成员名单未完整：实际{len(codes)} / 声明{total}')
+    raise RuntimeError('成员接口未返回声明的完整名单')
