+        raise ValueError('成员指数代码/名称无效')
+    limit, previous_total = 1000, None
+    for _ in range(2):
+        url = f'http://d.10jqka.com.cn/v2/blockrank/{code}/199112/d{limit}.js'
+        raw = http_get(url, headers={'Referer':'http://q.10jqka.com.cn/'},
+                       encoding='gbk', timeout=12, retry=1)
+        callback = re.search(r'^quotebridge_v2_blockrank_'+code+r'_199112_d'+str(limit)+r'\((.*)\)\s*;?\s*$', raw.strip(), re.S)
+        if not callback:
+            raise RuntimeError('成员接口回调与请求代码不一致')
+        obj = json.loads(callback.group(1))
+        block, items = obj.get('block') or {}, obj.get('items') or []
+        total = block.get('subcodeCount')
+        if block.get('name') != expected_name:
+            raise RuntimeError(f"成员指数名称未对齐：{block.get('name')!r} / {expected_name!r}")
