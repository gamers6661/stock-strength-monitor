+def revalidate_history(boards, quotes, calendar, now, session, path=None):
+    """报价昨收不一致时补核完成日线；日期齐全不代表源收盘已最终更新。"""
+    import board_quote
+    started = time.monotonic()
+    meta = dict(needed=0, attempted=0, repaired=0, failed=0, deferred=0)
+    needed = []
+    with closing(connect(path)) as conn:
+        states = {row[0]:row[1:] for row in conn.execute('SELECT board,name,target,checked,error FROM board_fetch_state')}
+    for board in boards:
+        daily = board.get('index_trend') or {}
+        code = daily.get('code')
+        q = quotes.get(code) or {}
+        if (board_quote.freshness(q, now, session) or q.get('code') != code
+                or q.get('name') != board['name']):
+            continue
+        days = [d for d in calendar if d < q['date']]
+        if not days:
+            continue
+        target = days[-1]
+        if daily.get('ready') and daily.get('asof') == target:
+            close = daily['close']
+        else:
+            bar = next((b for b in reversed(load(code, path)) if b['date'] == target), {})
+            close = bar.get('close')
+        if close is None or abs(q['previous_close']-close) <= .01:
+            continue
+        meta['needed'] += 1
+        last = states.get(code)
+        if (last and last[0] == board['name'] and last[1] == target
+                and str(last[3] or '').startswith('历史收盘补核：') and time.time()-last[2] < 300):
+            meta['deferred'] += 1
+            continue
+        needed.append((board, q, target))
+    if needed:
+        offset = int(time.time()//300) % len(needed)
+        needed = needed[offset:] + needed[:offset]
+    # 全池补核共用预算；仅主线程保存通过昨收对照的完整数据，迟到响应不改库。
+    def work(item):
+        board, q, target = item
+        try:
+            name, bars = parse_year(q['code'], target[:4], revalidate=True)
+            if name and name != board['name']:
+                raise ValueError('年度指数名称与目录不一致')
+            bars = [b for b in bars if b['date'] <= target]
+            dates = [b['date'] for b in bars]
+            if len(set(dates)) != len(dates):
+                raise ValueError('年度指数存在重复日期')
+            last = next((b for b in bars if b['date'] == target), {})
+            if not last or abs(last['close']-q['previous_close']) > .01:
+                raise ValueError('最新年度日线仍未与报价昨收对齐')
+            merged = {b['date']:b for b in load(q['code'], path)}
+            merged.update({b['date']:b for b in bars})
+            days = [d for d in calendar if d <= target]
+            checked = calculate(list(merged.values()), days, target)
+            if not checked['ready']:
+                raise ValueError(checked.get('reason') or '完成日线窗口未对齐')
+            return item, bars, None
+        except Exception as exc:
+            return item, [], '历史收盘补核：'+str(exc)
+    pool = ThreadPoolExecutor(max_workers=3)
+    futures = [pool.submit(work, item) for item in needed]
+    finished = 0
+    timed_out = False
+    try:
+        for future in as_completed(futures, timeout=max(.01, REVALIDATION_BUDGET_SECONDS)):
+            (board, q, target), bars, error = future.result()
+            finished += 1
+            meta['attempted'] += 1
+            if not error:
+                save(q['code'], bars, source=target[:4]+'.js', path=path)
+                updated = calculate(load(q['code'], path), calendar, board['index_trend']['expected_asof'])
+                updated.update(code=q['code'], name=board['name'], source=board['index_trend']['source'])
+                board['index_trend'] = updated
+                meta['repaired'] += 1
+            else:
+                board['index_trend']['revalidation_error'] = error
+                meta['failed'] += 1
+            with closing(connect(path)) as conn, conn:
+                conn.execute('INSERT OR REPLACE INTO board_fetch_state VALUES(?,?,?,?,?)',
+                             (q['code'],board['name'],target,time.time(),error))
+    except FuturesTimeoutError:
+        timed_out = True
+    finally:
+        for future in futures:
+            future.cancel()
+        pool.shutdown(wait=not timed_out)
+    meta['deferred'] += len(needed)-finished
+    meta['seconds'] = round(time.monotonic()-started, 3)
+    return meta
 
 
