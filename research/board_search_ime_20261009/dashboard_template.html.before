       .map(function(x){return '<div class="detail-stat"><small>'+x[0]+'</small><b>'+x[1]+'</b></div>';}).join('')+'</div>'
      +'<p class="flat" style="margin:12px 0 0">板块趋势 '+esc(selected.trend_state)+' · 今日活跃 '+fmt(selected.emotion_pct,1)+'%'
