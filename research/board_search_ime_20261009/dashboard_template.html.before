  }
  h+=structureDetail(s.code);
  if(path){
    h+='<details class="ui-evidence"><summary>日内采样路径<small>'+esc(path.state)+'</small></summary><div class="detail-panel" style="margin-bottom:18px"><div class="detail-panel-title">日内采样路径 · '+esc(path.state)+'</div>'
      +'<p class="flat">当天累计 '+fmt(path.acquired_count,0)+' 次获取，'+fmt(path.valid_count,0)+' 次有效，'+fmt(path.distinct_count,0)+' 个不同行情时刻，'+fmt(path.missing_count,0)+' 次待核验；判断截至 '+esc(String(path.last_at||'').slice(11,16))+'</p>'
      +'<p class="flat">'+esc((path.events||[]).map(function(e){return String(e.at).slice(11,16)+' '+e.kind;}).join('；')||'当前已保存的采样尚未观察到MA10收复或失守')+'</p>'
      +'<div class="tw" style="max-height:260px;overflow:auto"><table><thead><tr><th>行情截至</th><th>价格</th><th>盘中分</th><th>进攻档</th><th>观察状态</th></tr></thead><tbody>'
      +(path.recent||[]).map(function(p){return '<tr><td>'+esc(String(p.at||p.source_at||'').slice(11,19))+'</td><td>'+(p.price==null?'—':fmt(p.price,2))+'</td><td>'+(p.score==null?'未齐':(p.valid?'':'参考 ')+fmt(p.score,1))+'</td><td>'+esc(!p.valid?'未判断':p.attack_tier||(p.attack_score!=null?'趋势未在线':p.fund?'待核验':'旧记录未保存'))+'</td><td>'+esc(p.valid?(p.state||p.trend||'观察'):'本次待核验，未覆盖先前判断')+'</td></tr>';}).join('')
      +'</tbody></table></div><p class="flat">展示最近12次，当天全部获取保留在记录中。'+esc(path.note)+'</p></div></details>';
  }
