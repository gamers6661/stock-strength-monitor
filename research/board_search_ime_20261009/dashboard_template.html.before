    h+='<details class="ui-evidence"><summary>整理依据与确认记录</summary><div class="detail-panel"><div class="detail-panel-title">整理历史与确认过程 · '+esc(cd?cd.label:c.stage||'整理条件未满足')+'</div>';
    if(!c.eligible&&!c.completion_confirmed&&c.phase!=='completed')h+='<p class="flat">'+(ce.valid?'历史数据已核验，已有 '+ce.count+' 根日线；当前未满足整理条件。':'历史窗口尚未齐备，具体缺口见上方最新判断。')+'</p>';
    if(c.eligible||c.completion_confirmed||c.phase==='completed'){
      h+='<p class="flat">'+esc(consolidationPeriodText(c))+'。未完成的当日不计入完成交易日数。</p>';
      h+='<p class="flat">'+esc(c.trend_label)+' · '+esc(c.shape)+' · 整理 '+c.days+' 个完成交易日'+(c.post_breakout_days?'，再突破 '+c.post_breakout_days+' 日':'')+'；此前'+(c.attack_period||5)+'日进攻 '+pct(c.attack_gain_pct==null?c.impulse5_pct:c.attack_gain_pct,2)
        +'，上涨窗口截至 '+esc(c.impulse_end)+'，整理阶段 '+esc(c.consolidation_start)+' 至 '+esc(c.consolidation_asof||c.baseline_asof)+'。'+esc(c.attack_evidence)+'</p>'
        +'<p class="flat">完成日回撤 '+fmt(c.pullback_atr,2)+' ATR；整理量/上涨量 '+(c.volume_ratio==null?'待核验':fmt(c.volume_ratio,2)+'倍')
        +'；真实波幅变化 '+(c.contraction_ratio==null?'待核验':fmt(c.contraction_ratio,2)+'倍')+'。'+esc(c.volume_status)+'</p>';
      if(c.needs_repair_confirmation)h+='<p class="flat">历史分歧：'+esc((c.expanded_down_dates||[]).join('、')||(c.ma10_repaired?'曾失守MA10，已恢复完成日多头排列':'待核验'))+'；本轮修复价 '+(c.repair_trigger_price==null?'待核验':'¥'+fmt(c.repair_trigger_price,2))+'，连续 '+(c.repair_samples||0)+' 次有效采样收复。'+esc(c.structure_note||(c.phase==='completed'?'已完成整理并移出观察名单':c.repair_samples>=2?'已观察到连续修复':'整理中，尚待连续修复确认'))+'</p>';
      if(cd)h+='<p class="flat">固定平台上沿 ¥'+fmt(c.platform_high,2)+' · 当前价 ¥'+fmt(c.price,2)+' · 平台突破 '+(c.breakout_samples||0)+' 次、转强 '+(c.turn_samples||0)
        +' 次、守线 '+(c.hold_samples||0)+' 次有效采样；判断截至 '+esc(c.quote_at)+'。'+esc(cd.note)+'</p>';
    }
    if(c.completion_confirmed||c.phase==='completed'){
      h+='<p class="flat">历史转强：'+esc(c.completion_type||'待核验')+'；确认依据：'+esc(c.completion_evidence||'待核验')+'；确认时间 '+esc(c.completed_at||'待核验')+'；原转强位置（突破参考） '+(c.completion_trigger_price==null?'待核验':'¥'+fmt(c.completion_trigger_price,2))+'。历史确认不代表本轮仍在进攻。</p>';
      h+='<p class="flat">转强后状态：'+esc(c.stage||'待核验')+'；'+esc(c.reason||'')+'。MA10失守降级，MA20为退出边界；MA10连续失守 '+(c.ma10_below_samples||0)+' 次、连续收复 '+(c.ma10_recovery_samples||0)+' 次；MA20连续失守 '+(c.ma20_below_samples||0)+' 次、连续收复 '+(c.ma20_recovery_samples||0)+' 次。'+(c.trend_exit_at?'MA20退出时间 '+esc(c.trend_exit_at)+'。':'')+(c.trend_recovered_at?'MA20修复时间 '+esc(c.trend_recovered_at)+'。':'')+'</p>';
      if(c.close_review_day)h+='<p class="flat">正式收盘复核 '+esc(c.close_review_day)+'：'+esc(c.close_review_status)+'；收盘 ¥'+fmt(c.close_review_price,2)+' / MA10 ¥'+fmt(c.close_review_ma10,2)+' / MA20 ¥'+fmt(c.close_review_ma20,2)+'（同源'+esc(c.close_review_price_basis==='qfq'?'前复权日线':'未复权日线')+'口径，独立于上方盘中原报价）。</p>';
      else if(c.close_review_status)h+='<p class="flat">'+esc(c.close_review_status)+'：'+esc(c.close_review_reason||'')+'</p>';
    }
    if(c.rebound_confirmed)h+='<p class="flat">回踩反弹证据：靠近 MA'+c.rebound_line+'，靠线 '+esc(c.rebound_touch_at)+'（价格 ¥'+fmt(c.rebound_touch_price,2)+' / 均线边界 ¥'+fmt(c.rebound_touch_level,2)+'）；反弹确认 '+esc(c.rebound_confirmed_at)+'。'+esc(c.rebound_evidence)+'；'+(c.rebound_active?'当前仍保持反弹位置':'当前已回撤，历史证据保留')+'。靠线容差0.4 ATR，实质反弹需同时达到0.5 ATR及2%；反弹不豁免分歧修复及转强条件。</p>';
    if((c.support_alerts||[]).length)h+='<p class="flat">支撑位置提示：'+esc(c.support_alerts.map(function(a){return a.label+' ¥'+fmt(a.price,2)+'，距支撑 '+fmt(a.distance_atr,2)+' ATR';}).join('；'))+'。截至 '+esc(c.support_alert_at)+'，'+(consolidationSupportBasis(c)==='completed_daily'?'同源正式日线口径':'与现价相同的已核验报价口径')+'；只提示位置，尚不构成反弹或转强确认。</p>';
    if(c.legacy_ma10_exit_at)h+='<p class="flat">旧规则MA10退出留档 '+esc(c.legacy_ma10_exit_at)+'；已按MA20规则重新核验，不计作本版MA20退出事件。</p>';
    if(c.reason)h+='<p class="flat">'+esc(c.reason)+'</p>';
