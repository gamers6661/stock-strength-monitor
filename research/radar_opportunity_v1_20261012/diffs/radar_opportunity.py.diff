+def directory():
+    if DIRECTORY!=_DEFAULT_DIRECTORY:return DIRECTORY
+    return (config.SNAPSHOT_JSON.parent if config.SNAPSHOT_JSON!=_DEFAULT_SNAPSHOT else config.CACHE_DIR)/'radar_opportunity_v1'
